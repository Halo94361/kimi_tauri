{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability set for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-last-error",
    "allow-restart-server",
    "allow-remote-status",
    "allow-retry-remote",
    "allow-proxy-status",
    "allow-retry-proxy",
    "allow-switch-tab",
    "allow-report-theme",
    "allow-sync-theme",
    "allow-session-stats",
    "allow-daily-stats",
    "allow-weekly-stats",
    "allow-stats-restore",
    "allow-stats-set-size",
    "allow-stats-set-visible",
    "allow-stats-focus-content",
    "allow-stats-drag-start",
    "allow-stats-reset-position",
    "allow-disconnect-remote",
    "allow-get-settings",
    "allow-set-settings",
    "allow-reset-settings",
    "allow-get-diagnostics",
    "allow-refresh-cli-info",
    "allow-upgrade-cli",
    "allow-open-config-target"
  ]
}
